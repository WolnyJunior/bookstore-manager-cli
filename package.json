{
  "name": "bookestore-manager-cli",
  "version": "1.0.0",
  "main": "dist/main.js",
  "description": "CLI de gerenciamento de livraria com Node.js, TypeCript e PostgreSQL",
  "keywords": [
    "nodejs",
    "typescript",
    "cli",
    "postgresql"
  ],
  "author": "WolnyJr",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  }
}
